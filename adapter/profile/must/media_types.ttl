@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<#DescribedFile> a sh:NodeShape ;
  sh:name "Media types" ;
  sh:targetSubjectsOf schema:encodingFormat ;
  sh:property [
    sh:path schema:encodingFormat ;
    sh:datatype xsd:string ;
    sh:or (
      [ sh:in (
        "application/gzip"
        "application/json"
        "application/ld+json"
        "application/schema+json"
        "application/sparql-query"
        "application/xml"
        "application/yaml"
        "text/csv"
        "text/markdown"
        "text/plain"
        "text/turtle"
        "text/xml"
      ) ]
      [ sh:pattern "^[a-z]+/[a-z0-9.!#$&^_-]+[+](json|xml)$" ]
    ) ;
    sh:message "encodingFormat is one of the media types an adapter package may declare: application/gzip, application/json, application/ld+json, application/schema+json, application/sparql-query, application/xml, application/yaml, text/csv, text/markdown, text/plain, text/turtle, text/xml, or a type with the +json or +xml suffix."
  ] .
