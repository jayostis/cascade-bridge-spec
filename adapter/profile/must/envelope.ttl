@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<#Envelope> a sh:NodeShape ;
  sh:name "Envelope" ;
  sh:targetClass bridge:Envelope ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^[a-z][a-z0-9-]*$" ;
    sh:message "An envelope carries exactly one name, its short id: lowercase letters, digits and hyphens, starting with a letter."
  ] ;
  sh:property [
    sh:path bridge:docRootElementName ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "An envelope carries at most one bridge:docRootElementName, the local name of its document element."
  ] ;
  sh:property [
    sh:path bridge:docRootMemberName ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "An envelope carries at most one bridge:docRootMemberName, the name of a member the object a JSON document holds carries."
  ] ;
  sh:property [
    sh:path bridge:docRootMemberValue ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "An envelope carries at most one bridge:docRootMemberValue, the value of the member its bridge:docRootMemberName names, as the JSON lift writes it."
  ] ;
  sh:property [
    sh:path bridge:jsonPathOfEachRecord ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^\\$(\\.[A-Za-z_\u0080-퟿-\U0010FFFF][A-Za-z0-9_\u0080-퟿-\U0010FFFF]*|\\['([^'\\\\]|\\\\.)*'\\]|\\[\\*\\])*$" ;
    sh:message "An envelope carries at most one bridge:jsonPathOfEachRecord, written in the subset of RFC 9535 JSONPath engine/sparql.md specifies: $ followed by segments each .name, ['name'] or [*]."
  ] ;
  sh:sparql [
    sh:message "An envelope of an adapter whose bridge:sourceMediaType is XML carries a bridge:docRootElementName, and none of bridge:docRootMemberName, bridge:docRootMemberValue and bridge:jsonPathOfEachRecord." ;
    sh:select """
      SELECT $this WHERE {
        ?adapter <https://ns.cascadeprotocol.org/bridge/v1-draft#envelope> $this ;
                 <https://ns.cascadeprotocol.org/bridge/v1-draft#sourceMediaType> ?mediaType .
        FILTER (REGEX(?mediaType, "^(application/xml|text/xml|[a-z]+/[a-z0-9.!#$&^_-]+[+]xml)$"))
        FILTER (
          NOT EXISTS { $this <https://ns.cascadeprotocol.org/bridge/v1-draft#docRootElementName> ?name }
          || EXISTS {
            $this ?term ?value .
            FILTER (?term IN (
              <https://ns.cascadeprotocol.org/bridge/v1-draft#docRootMemberName>,
              <https://ns.cascadeprotocol.org/bridge/v1-draft#docRootMemberValue>,
              <https://ns.cascadeprotocol.org/bridge/v1-draft#jsonPathOfEachRecord>
            ))
          }
        )
      }
    """
  ] ;
  sh:sparql [
    sh:message "An envelope of an adapter whose bridge:sourceMediaType is JSON carries a bridge:docRootMemberName and a bridge:jsonPathOfEachRecord, and no bridge:docRootElementName." ;
    sh:select """
      SELECT $this WHERE {
        ?adapter <https://ns.cascadeprotocol.org/bridge/v1-draft#envelope> $this ;
                 <https://ns.cascadeprotocol.org/bridge/v1-draft#sourceMediaType> ?mediaType .
        FILTER (REGEX(?mediaType, "^(application/json|[a-z]+/[a-z0-9.!#$&^_-]+[+]json)$"))
        FILTER (
          NOT EXISTS { $this <https://ns.cascadeprotocol.org/bridge/v1-draft#docRootMemberName> ?name }
          || NOT EXISTS { $this <https://ns.cascadeprotocol.org/bridge/v1-draft#jsonPathOfEachRecord> ?path }
          || EXISTS { $this <https://ns.cascadeprotocol.org/bridge/v1-draft#docRootElementName> ?element }
        )
      }
    """
  ] ;
  sh:property [
    sh:path bridge:pathOfContentInRecord ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^(/.*[^/])?$" ;
    sh:message "An envelope carries at most one bridge:pathOfContentInRecord, a path of its source format: empty, or beginning with a / and not ending with one."
  ] ;
  sh:property [
    sh:path bridge:pathOfContainedContentBelowContent ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^/.*[^/]$" ;
    sh:message "An envelope carries at most one bridge:pathOfContainedContentBelowContent, a path of its source format beginning with a / and not ending with one."
  ] ;
  sh:property [
    sh:path bridge:pathOfRecordKindBelowContent ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^/.*[^/]$" ;
    sh:message "An envelope carries at most one bridge:pathOfRecordKindBelowContent, a path of its source format beginning with a / and not ending with one."
  ] ;
  sh:sparql [
    sh:message "A path an envelope of a JSON adapter declares in bridge:pathOfContentInRecord, bridge:pathOfContainedContentBelowContent or bridge:pathOfRecordKindBelowContent is the names of the members from the record down, each after a /, ~ written ~0 and / written ~1, with no empty reference token: {?value} is not." ;
    sh:select """
      SELECT $this ?value WHERE {
        ?adapter <https://ns.cascadeprotocol.org/bridge/v1-draft#envelope> $this ;
                 <https://ns.cascadeprotocol.org/bridge/v1-draft#sourceMediaType> ?mediaType .
        FILTER (REGEX(?mediaType, "^(application/json|[a-z]+/[a-z0-9.!#$&^_-]+[+]json)$"))
        $this ?term ?value .
        FILTER (?term IN (
          <https://ns.cascadeprotocol.org/bridge/v1-draft#pathOfContentInRecord>,
          <https://ns.cascadeprotocol.org/bridge/v1-draft#pathOfContainedContentBelowContent>,
          <https://ns.cascadeprotocol.org/bridge/v1-draft#pathOfRecordKindBelowContent>
        ))
        FILTER (STR(?value) != "" && !REGEX(STR(?value), "^(/([^/~]|~[01])+)+$"))
      }
    """
  ] ;
  sh:sparql [
    sh:message "No two envelopes of an adapter declare the same bridge:pathOfContentInRecord: {?value} is declared twice." ;
    sh:select """
      SELECT $this ?value WHERE {
        ?adapter <https://ns.cascadeprotocol.org/bridge/v1-draft#envelope> $this, ?other .
        FILTER ($this != ?other)
        $this <https://ns.cascadeprotocol.org/bridge/v1-draft#pathOfContentInRecord> ?value .
        ?other <https://ns.cascadeprotocol.org/bridge/v1-draft#pathOfContentInRecord> ?otherValue .
        FILTER (STR(?value) = STR(?otherValue))
      }
    """
  ] ;
  sh:sparql [
    sh:message "An envelope's bridge:pathOfRecordKindBelowContent is not at or below its bridge:pathOfContainedContentBelowContent, where another record's content stands: {?value} is." ;
    sh:select """
      SELECT $this ?value WHERE {
        $this <https://ns.cascadeprotocol.org/bridge/v1-draft#pathOfContainedContentBelowContent> ?contained ;
              <https://ns.cascadeprotocol.org/bridge/v1-draft#pathOfRecordKindBelowContent> ?value .
        FILTER (?value = ?contained || STRSTARTS(?value, CONCAT(?contained, "/")))
      }
    """
  ] ;
  sh:property [
    sh:path bridge:sourceSchema ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "An envelope carries at most one bridge:sourceSchema, by IRI."
  ] ;
  sh:sparql [
    sh:message "An envelope's bridge:sourceSchema names a crate File entity (schema:MediaObject), or a fragment of one, not a bare IRI naming nothing: {?value} does not." ;
    sh:select """
      SELECT $this ?value WHERE {
        $this <https://ns.cascadeprotocol.org/bridge/v1-draft#sourceSchema> ?value .
        FILTER NOT EXISTS {
          ?file a <http://schema.org/MediaObject> .
          FILTER (STR(?file) = STRBEFORE(CONCAT(STR(?value), "#"), "#"))
        }
      }
    """
  ] ;
  sh:property [
    sh:path bridge:schemaImport ;
    sh:nodeKind sh:IRI ;
    sh:class schema:MediaObject ;
    sh:message "Each bridge:schemaImport is a crate File entity (schema:MediaObject) by IRI, not a bare IRI or a literal naming nothing."
  ] ;
  sh:property [
    sh:path bridge:documentSchema ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:MediaObject ;
    sh:message "An envelope carries at most one bridge:documentSchema, and it is a crate File entity (schema:MediaObject), not a bare IRI naming nothing."
  ] .
