# The adapter lint as an RO-Crate profile.
#
# rocrate-validator loads a profile from a directory like this one and runs its
# requirements -- SHACL in .ttl files, Python in .py files -- alongside the ones
# it inherits. So the checks of adapter/validation.md run in the same pass as
# RO-Crate 1.2 conformance, reported the same way, rather than in a harness of
# this repository's own.
#
# The identifying IRI is the one an adapter already names in conformsTo, which
# is what adapter/profile/ro-crate-metadata.json describes. That file is the
# Profile Crate, the normative declaration; this directory is how the checks
# run.

@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://ns.cascadeprotocol.org/bridge/v1-draft/adapter-profile/>
    a prof:Profile ;

    rdfs:label "Cascade Bridge Adapter" ;

    # Stated rather than left to be derived from this directory's path, which
    # the validator does by stripping its base path with a forward slash: on
    # Windows that leaves the whole absolute path as the profile's name.
    prof:hasToken "cascade-bridge-adapter" ;

    rdfs:comment """The contract an adapter package conforms to: the crate and
    its test manifest as one graph, every tracked file described, every digest
    recomputed, every input against its declared schema, every expected graph
    parsed and every query in the form its property declares."""@en ;

    dct:publisher <https://github.com/jayostis/cascade-bridge-spec> ;

    # An adapter package is an RO-Crate 1.2 first; everything here is on top.
    prof:isProfileOf <https://w3id.org/ro/crate/1.2> ;
    prof:isTransitiveProfileOf <https://w3id.org/ro/crate/1.2> .
