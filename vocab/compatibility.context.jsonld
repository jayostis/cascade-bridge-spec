{
  "@context": {
    "@version": 1.1,
    "@base": null,
    "bridge": "https://ns.cascadeprotocol.org/bridge/v1-draft#",
    "host": {
      "@id": "bridge:host",
      "@container": "@set",
      "@context": {
        "name": "http://schema.org/name",
        "release": {
          "@id": "bridge:release",
          "@context": {
            "asset": "bridge:asset",
            "path": "bridge:path"
          }
        }
      }
    },
    "setup": {
      "@id": "bridge:setup",
      "@container": "@list"
    },
    "command": {
      "@id": "bridge:command",
      "@container": "@list"
    },
    "mustPassWith": {
      "@id": "bridge:mustPassWith",
      "@container": "@set",
      "@type": "@id"
    }
  }
}
