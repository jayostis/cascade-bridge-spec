@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .

<https://ns.cascadeprotocol.org/bridge/v1-draft#> a owl:Ontology ;
  dct:title "Cascade Bridge Vocabulary"@en ;
  dct:created "2026-09-06"^^xsd:date ;
  owl:versionInfo "v1-draft" ;
  rdfs:comment "DRAFT. No compatibility is promised before a numbered release."@en ;
  rdfs:seeAlso <https://github.com/jayostis/cascade-bridge-spec> .

# Adapter terms

bridge:Adapter a owl:Class ;
  rdfs:label "Adapter"@en ;
  rdfs:comment "The root entity of an adapter package's RO-Crate."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:Envelope a owl:Class ;
  rdfs:label "Envelope"@en ;
  rdfs:comment "A document root the source format arrives in. A Bridge accepts any of the adapter's envelopes and splits each on the unit."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:Profile a owl:Class ;
  rdfs:label "Profile"@en ;
  rdfs:comment "A capability beyond Core that a Bridge may offer and an adapter may require."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:sparql-1.1 a bridge:Profile ;
  rdfs:label "sparql-1.1"@en ;
  rdfs:comment "Specified by engine/sparql.md in the cascade-bridge-spec repository."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:profileRequired a owl:ObjectProperty ;
  rdfs:label "profile required"@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:range bridge:Profile ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:specPin a owl:ObjectProperty ;
  rdfs:label "specification pin"@en ;
  rdfs:comment "The cascade-bridge-spec commit the adapter is written against."@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:vocabularyPin a owl:ObjectProperty ;
  rdfs:label "vocabulary pin"@en ;
  rdfs:comment "The commit of Cascade's spec repository the adapter's vocabularies are read at."@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:vocabulary a owl:ObjectProperty ;
  rdfs:label "vocabulary"@en ;
  rdfs:comment "A Cascade vocabulary the adapter writes, by namespace IRI, whose schema:version is the vocabulary's version at the vocabulary pin."@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:sourceMediaType a owl:DatatypeProperty ;
  rdfs:label "source media type"@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:sourceSchema a owl:ObjectProperty ;
  rdfs:label "source schema"@en ;
  rdfs:comment "The XSD a Bridge validates every unit against."@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:envelope a owl:ObjectProperty ;
  rdfs:label "envelope"@en ;
  rdfs:range bridge:Envelope ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:unit a owl:DatatypeProperty ;
  rdfs:label "unit"@en ;
  rdfs:comment "The local name of the element a Bridge splits a document on and hands to the mapping one at a time. The unit's raw bytes are preserved."@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:mapping a owl:ObjectProperty ;
  rdfs:label "mapping"@en ;
  rdfs:comment "A SPARQL 1.1 CONSTRUCT a Bridge runs on each unit. A unit's graph is the union of every mapping's results."@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:findingsQuery a owl:ObjectProperty ;
  rdfs:label "findings query"@en ;
  rdfs:comment "A SPARQL 1.1 SELECT over the same dataset as the mappings, projecting ?sourceField ?reason ?severity ?context and no other variable. Each row is one finding; rows are not deduplicated, and a unit's findings are the rows of every findings query, concatenated."@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:detectQuery a owl:ObjectProperty ;
  rdfs:label "detect query"@en ;
  rdfs:comment "A SPARQL 1.1 ASK over a document's envelope skeleton, true when the adapter handles the document."@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:table a owl:ObjectProperty ;
  rdfs:label "table"@en ;
  rdfs:comment "A lookup table the mapping reads. One declared text/turtle is loaded beside each unit's lift before the mappings run; no other table format is specified."@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:extensionVocabulary a owl:ObjectProperty ;
  rdfs:label "extension vocabulary"@en ;
  rdfs:comment "The adapter's own namespace for values that have no Cascade term."@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:testManifest a owl:ObjectProperty ;
  rdfs:label "test manifest"@en ;
  rdfs:domain bridge:Adapter ;
  rdfs:range mf:Manifest ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:rootElement a owl:DatatypeProperty ;
  rdfs:label "root element"@en ;
  rdfs:comment "The local name of the document element."@en ;
  rdfs:domain bridge:Envelope ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:documentSchema a owl:ObjectProperty ;
  rdfs:label "document schema"@en ;
  rdfs:comment "A schema that validates a whole document in this envelope, where the source schema does not declare its root."@en ;
  rdfs:domain bridge:Envelope ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

# Test terms, used with W3C's mf: test-manifest vocabulary

bridge:IsomorphicConversionTest a owl:Class ;
  rdfs:subClassOf mf:ManifestEntry ;
  rdfs:label "Isomorphic conversion test"@en ;
  rdfs:comment "Run the mapping on bridge:input. The produced graph must be isomorphic to bridge:graph (blank nodes relabelled, IRIs and literals exact) after every triple whose predicate is a bridge:ignorePredicate is removed from both sides. The produced findings must equal bridge:findings as a multiset: the same entries with the same multiplicity, in any order, two entries being equal as JSON objects."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:InputOnlyTest a owl:Class ;
  rdfs:subClassOf mf:ManifestEntry ;
  rdfs:label "Input-only test"@en ;
  rdfs:comment "Parse and validate bridge:input; record the produced graph and findings; judge nothing."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:DatasetCompletionTest a owl:Class ;
  rdfs:subClassOf mf:ManifestEntry ;
  rdfs:label "Dataset completion test"@en ;
  rdfs:comment "Stream bridge:dataset in its envelope; the run must complete without rejection. Where bridge:records and bridge:outputDigest are present they must match; where absent the harness records them."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:LiftTest a owl:Class ;
  rdfs:subClassOf mf:ManifestEntry ;
  rdfs:label "Lift test"@en ;
  rdfs:comment "A test of a Bridge offering bridge:sparql-1.1: lift bridge:input with its document element as the lift root. The produced graph must be isomorphic to bridge:graph, blank nodes relabelled and IRIs and literals exact. No mapping runs, and nothing is removed from either side."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:SkeletonTest a owl:Class ;
  rdfs:subClassOf mf:ManifestEntry ;
  rdfs:label "Envelope skeleton test"@en ;
  rdfs:comment "A test of a Bridge offering bridge:sparql-1.1: build the envelope skeleton of bridge:input, with the action's bridge:unit as the unit's local name. The produced graph must be isomorphic to bridge:graph, blank nodes relabelled and IRIs and literals exact. Nothing is removed from either side."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:adapter a owl:ObjectProperty ;
  rdfs:label "adapter"@en ;
  rdfs:domain mf:Manifest ;
  rdfs:range bridge:Adapter ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:input a owl:ObjectProperty ;
  rdfs:label "input"@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:dataset a owl:ObjectProperty ;
  rdfs:label "dataset"@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:graph a owl:ObjectProperty ;
  rdfs:label "graph"@en ;
  rdfs:comment "The expected graph."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:findings a owl:ObjectProperty ;
  rdfs:label "findings"@en ;
  rdfs:comment "The expected findings sidecar."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:records a owl:DatatypeProperty ;
  rdfs:label "records"@en ;
  rdfs:comment "The number of units processed."@en ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:outputDigest a owl:DatatypeProperty ;
  rdfs:label "output digest"@en ;
  rdfs:comment "The sha256 of the canonical N-Quads output, stamp triples removed."@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:ignorePredicate a owl:ObjectProperty ;
  rdfs:label "ignore predicate"@en ;
  rdfs:comment "A stamp predicate, a triple a Bridge adds after the mapping, removed from both sides before comparison. Stated on the mf:Manifest, every entry inherits the set; an entry that carries its own replaces the manifest's set for that entry alone."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

# Compatibility terms, the keys of a compatibility.json

bridge:specification a owl:ObjectProperty ;
  rdfs:label "specification"@en ;
  rdfs:comment "The pin of cascade-bridge-spec an engine is written against."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:setup a owl:ObjectProperty ;
  rdfs:label "setup"@en ;
  rdfs:comment "The argument vector that prepares an engine to run, run without a shell in the engine's checkout."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:command a owl:ObjectProperty ;
  rdfs:label "command"@en ;
  rdfs:comment "The argument vector that runs an engine's test command (engine/command.md), run without a shell in the engine's checkout."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:testedWith a owl:ObjectProperty ;
  rdfs:label "tested with"@en ;
  rdfs:comment "A counterpart this repository asserts it passes with: an adapter an engine runs, or an engine that runs an adapter. It holds when the engine's EARL report records an outcome for every entry of the adapter's test manifest and none is earl:failed or earl:inapplicable."@en ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:tag a owl:DatatypeProperty ;
  rdfs:label "tag"@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

bridge:branch a owl:DatatypeProperty ;
  rdfs:label "branch"@en ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
