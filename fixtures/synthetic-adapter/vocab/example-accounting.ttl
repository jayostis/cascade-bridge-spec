@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix ex:     <https://example.org/synthetic-adapter/v1#> .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecordSet" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecordSet/ExampleRecord" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecordSet/ExampleRecord/@Accession" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecordSet/ExampleRecord/@Version" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecordSet/ExampleRecord/Label" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecordSet/ExampleRecord/Note" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap ex:no-term-for-a-free-text-note .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecord" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecord/@Accession" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecord/@Version" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecord/Label" ;
  bridge:verdict bridge:carried .

[] a bridge:PathEntry ;
  bridge:sourcePath "/ExampleRecord/Note" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap ex:no-term-for-a-free-text-note .
