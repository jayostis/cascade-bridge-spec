PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX fx:   <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:  <http://sparql.xyz/facade-x/data/>
PREFIX ex:   <https://example.org/synthetic-adapter/v1#>

CONSTRUCT {
  ?record a ex:Record ;
    ex:accession ?accession ;
    ex:version ?version ;
    rdfs:label ?label .
}
WHERE {
  ?exampleRecord a fx:root, xyz:ExampleRecord ;
    xyz:Accession ?accession ;
    xyz:Version ?number .
  BIND(IRI(CONCAT("https://example.org/synthetic-adapter/record/",
                  ?accession)) AS ?record)
  BIND(STRDT(?number, xsd:integer) AS ?version)
  OPTIONAL { ?exampleRecord ?slot ?element . ?element a xyz:Label ; rdf:_1 ?label }
}
