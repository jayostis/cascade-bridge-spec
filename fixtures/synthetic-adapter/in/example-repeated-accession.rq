PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ex:     <https://example.org/synthetic-adapter/v1#>

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [ oa:hasSource bridge:thisRecord ] ;
    oa:hasBody ex:an-accession-repeated-within-its-document ;
    oa:motivatedBy oa:classifying .
}
WHERE {
  ?exampleRecord a fx:root, xyz:ExampleRecord ;
    xyz:Accession ?accession .
  FILTER EXISTS {
    ?holder ex:holdsAccession ?accession .
    ?another ex:holdsAccession ?accession .
    FILTER (?holder != ?another)
  }
}
