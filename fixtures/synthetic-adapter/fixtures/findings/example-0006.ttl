@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix oa:  <http://www.w3.org/ns/oa#> .
@prefix ex:  <https://example.org/synthetic-adapter/v1#> .

[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/example-0006.xml> ;
    oa:hasSelector [
      a oa:XPathSelector ;
      rdf:value "/ExampleRecordSet/ExampleRecord[1]" ;
      oa:refinedBy [ a oa:XPathSelector ; rdf:value "Label" ]
    ]
  ] ;
  oa:hasBody ex:only-the-first-run-of-a-labels-text-is-carried ;
  oa:motivatedBy oa:classifying ;
  sh:resultSeverity sh:Violation .

[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/example-0006.xml> ;
    oa:hasSelector [
      a oa:XPathSelector ;
      rdf:value "/ExampleRecordSet/ExampleRecord[1]" ;
      oa:refinedBy [ a oa:XPathSelector ; rdf:value "Status" ]
    ]
  ] ;
  oa:hasBody ex:only-the-latest-status-is-carried ;
  oa:motivatedBy oa:classifying ;
  sh:resultSeverity sh:Warning .

[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <../in/example-0006.xml> ;
    oa:hasSelector [ a oa:XPathSelector ; rdf:value "/ExampleRecordSet/ExampleRecord[1]" ]
  ] ;
  oa:hasBody ex:the-record-names-no-submitter ;
  oa:motivatedBy oa:classifying ;
  sh:resultSeverity sh:Info .
