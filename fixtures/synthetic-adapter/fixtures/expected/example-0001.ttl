@prefix ex:   <https://example.org/synthetic-adapter/v1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/synthetic-adapter/record/EX000001>
  a ex:Record ;
  ex:accession "EX000001" ;
  ex:version "3"^^xsd:integer ;
  rdfs:label "first synthetic record" .

<https://example.org/synthetic-adapter/record/EX000002>
  a ex:Record ;
  ex:accession "EX000002" ;
  ex:version "1"^^xsd:integer ;
  rdfs:label "second synthetic record" .
