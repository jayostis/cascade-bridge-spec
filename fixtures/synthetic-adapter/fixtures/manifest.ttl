@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "synthetic adapter fixture cases" ;
  bridge:adapter <../> ;
  mf:entries (
    <#example-0001>
    <#example-0002>
    <#example-0003>
    <#example-0004>
    <#example-0005>
    <#example-release-2026-01>
  ) .

<#example-0001> a bridge:IsomorphicConversionTest ;
  mf:name "example-0001" ;
  mf:action [
    bridge:input <in/example-0001.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/example-0001.ttl> ;
    bridge:expectedFindings <findings/example-0001.ttl>
  ] .

<#example-0002> a bridge:InputOnlyTest ;
  mf:name "example-0002" ;
  mf:action [
    bridge:input <in/example-0002.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record>
  ] .

<#example-0003> a bridge:IsomorphicConversionTest ;
  mf:name "example-0003" ;
  rdfs:comment "A document that fails its bridge:documentSchema around a record that passes bridge:sourceSchema: its findings are about the document, one for each W3C rule the undeclared element breaks, each refined to that element." ;
  mf:action [
    bridge:input <in/example-0003.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/example-0003.ttl> ;
    bridge:expectedFindings <findings/example-0003.ttl>
  ] .

<#example-0004> a bridge:IsomorphicConversionTest ;
  mf:name "example-0004" ;
  rdfs:comment "A record carrying nodes the adapter's bridge:sourceAccounting names nowhere — an element, an attribute of a child element, an attribute of the record element, and an attribute in a namespace: its findings are the census finding for each path, addressed at its first occurrence in the record." ;
  mf:action [
    bridge:input <in/example-0004.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/example-0004.ttl> ;
    bridge:expectedFindings <findings/example-0004.ttl>
  ] .

<#example-0005> a bridge:IsomorphicConversionTest ;
  mf:name "example-0005" ;
  rdfs:comment "A record standing at a path its entry names a gap for more than once, at another exactly once, at a path in a namespace whose gap declares sh:Warning, at a path whose entry names no gap, and at a path the accounting names nowhere more than once: each is one finding at the path's first occurrence, carrying bridge:occurrences where the path repeats. The gap at /ExampleRecord/Note is reported by its entry and constructed by the findings query, and both findings stand." ;
  mf:action [
    bridge:input <in/example-0005.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/example-0005.ttl> ;
    bridge:expectedFindings <findings/example-0005.ttl>
  ] .

<#example-release-2026-01> a bridge:DatasetCompletionTest ;
  mf:name "example-release-2026-01" ;
  mf:action [
    bridge:dataset <https://example.org/synthetic-adapter/releases/example-release-2026-01.xml.gz> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] .
