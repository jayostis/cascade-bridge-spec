@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "synthetic adapter fixture cases" ;
  bridge:adapter <../> ;
  mf:entries (
    <#example-0001>
    <#example-0002>
    <#example-0003>
    <#example-release-2026-01>
  ) .

<#example-0001> a bridge:IsomorphicConversionTest ;
  mf:name "example-0001" ;
  mf:action [
    bridge:input <in/example-0001.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/example-0001.ttl> ;
    bridge:expectedFindings <findings/example-0001.ttl>
  ] .

<#example-0002> a bridge:InputOnlyTest ;
  mf:name "example-0002" ;
  mf:action [
    bridge:input <in/example-0002.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record>
  ] .

<#example-0003> a bridge:IsomorphicConversionTest ;
  mf:name "example-0003" ;
  rdfs:comment "A document that fails its bridge:documentSchema around a record that passes bridge:sourceSchema: its one finding is about the document, and selects the document element." ;
  mf:action [
    bridge:input <in/example-0003.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/example-0003.ttl> ;
    bridge:expectedFindings <findings/example-0003.ttl>
  ] .

<#example-release-2026-01> a bridge:DatasetCompletionTest ;
  mf:name "example-release-2026-01" ;
  mf:action [
    bridge:dataset <https://example.org/synthetic-adapter/releases/example-release-2026-01.xml.gz> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] .
