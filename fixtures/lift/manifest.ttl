@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "sparql-1.1 lift vectors" ;
  mf:entries (
    <#attributes>
    <#mixed-content>
    <#whitespace>
    <#cdata>
    <#dropped>
    <#namespaces>
    <#no-break-space>
    <#non-ascii>
    <#skeleton>
    <#skeleton-record-root>
  ) .

<#attributes> a bridge:LiftTest ;
  mf:name "attributes" ;
  rdfs:comment "Each attribute is a plain string literal on its element's node." ;
  mf:action [ bridge:input <attributes.xml> ] ;
  mf:result [ bridge:expectedGraph <attributes.nt> ] .

<#mixed-content> a bridge:LiftTest ;
  mf:name "mixed-content" ;
  rdfs:comment "Text and element children share one numbering, in document order, and text keeps its spaces." ;
  mf:action [ bridge:input <mixed-content.xml> ] ;
  mf:result [ bridge:expectedGraph <mixed-content.nt> ] .

<#whitespace> a bridge:LiftTest ;
  mf:name "whitespace" ;
  rdfs:comment "Whitespace-only text is dropped and takes no number; text with any other character is kept verbatim, spaces included." ;
  mf:action [ bridge:input <whitespace.xml> ] ;
  mf:result [ bridge:expectedGraph <whitespace.nt> ] .

<#cdata> a bridge:LiftTest ;
  mf:name "cdata" ;
  rdfs:comment "Character data and a CDATA section beside it are one text child." ;
  mf:action [ bridge:input <cdata.xml> ] ;
  mf:result [ bridge:expectedGraph <cdata.nt> ] .

<#dropped> a bridge:LiftTest ;
  mf:name "dropped" ;
  rdfs:comment "The XML declaration, the document type declaration, comments and processing instructions are dropped, and text on either side of a dropped comment is one text child." ;
  mf:action [ bridge:input <dropped.xml> ] ;
  mf:result [ bridge:expectedGraph <dropped.nt> ] .

<#namespaces> a bridge:LiftTest ;
  mf:name "namespaces" ;
  rdfs:comment "A namespaced element or attribute is named by its namespace IRI and local name; an unnamespaced one under the Facade-X data namespace. The namespace declaration is not an attribute." ;
  mf:action [ bridge:input <namespaces.xml> ] ;
  mf:result [ bridge:expectedGraph <namespaces.nt> ] .

<#no-break-space> a bridge:LiftTest ;
  mf:name "no-break-space" ;
  rdfs:comment "Whitespace is XML's S production, space, tab, CR and LF. A no-break space is not whitespace: alone it is a text child, beside spaces the text is kept verbatim, and a text of only a line feed is dropped." ;
  mf:action [ bridge:input <no-break-space.xml> ] ;
  mf:result [ bridge:expectedGraph <no-break-space.nt> ] .

<#non-ascii> a bridge:LiftTest ;
  mf:name "non-ascii" ;
  rdfs:comment "A name an IRI can carry is carried as its own characters, whatever plane it is from; the last element's name ends in U+FFF9, which is an XML name character and not an iunreserved one, so it is percent-encoded as its UTF-8 octets. eE5ND8 is here because encoding UTF-16 code units rather than UTF-8 octets writes the date attribute's name as that." ;
  mf:action [ bridge:input <non-ascii.xml> ] ;
  mf:result [ bridge:expectedGraph <non-ascii.nt> ] .

<#skeleton> a bridge:SkeletonTest ;
  mf:name "skeleton" ;
  rdfs:comment "A record keeps its type triples and its number among its parent's children, and loses its attributes and its children. A sibling that is not a record is lifted whole, and the numbering counts the emptied records." ;
  mf:action [ bridge:input <skeleton.xml> ; bridge:elementNameOfEachRecord "Unit" ] ;
  mf:result [ bridge:expectedGraph <skeleton.nt> ] .

<#skeleton-record-root> a bridge:SkeletonTest ;
  mf:name "skeleton-record-root" ;
  rdfs:comment "A record that is the document element is emptied like any other, so the skeleton is its type triples alone: the lift root type and its own. A Bridge that special-cases the root instead routes on a document it has lifted entirely." ;
  mf:action [ bridge:input <skeleton-record-root.xml> ; bridge:elementNameOfEachRecord "Unit" ] ;
  mf:result [ bridge:expectedGraph <skeleton-record-root.nt> ] .
