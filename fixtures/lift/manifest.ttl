# The lift vectors: what a Bridge offering bridge:sparql-1.1 must produce from
# each document, lifted with its document element as the lift root
# (engine/sparql.md). Each entry is judged by the bridge:LiftTest rule. This is
# not an adapter's test manifest: it names no adapter, and a Bridge runs it to
# test itself.

@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "sparql-1.1 lift vectors" ;
  mf:entries (
    <#attributes>
    <#mixed-content>
    <#whitespace>
    <#cdata>
    <#dropped>
    <#namespaces>
  ) .

<#attributes> a bridge:LiftTest ;
  mf:name "attributes" ;
  rdfs:comment "Each attribute is a plain string literal on its element's node." ;
  mf:action [ bridge:input <attributes.xml> ] ;
  mf:result [ bridge:graph <attributes.nt> ] .

<#mixed-content> a bridge:LiftTest ;
  mf:name "mixed-content" ;
  rdfs:comment "Text and element children share one numbering, in document order, and text keeps its spaces." ;
  mf:action [ bridge:input <mixed-content.xml> ] ;
  mf:result [ bridge:graph <mixed-content.nt> ] .

<#whitespace> a bridge:LiftTest ;
  mf:name "whitespace" ;
  rdfs:comment "Whitespace-only text is dropped and takes no number; text with any other character is kept verbatim, spaces included." ;
  mf:action [ bridge:input <whitespace.xml> ] ;
  mf:result [ bridge:graph <whitespace.nt> ] .

<#cdata> a bridge:LiftTest ;
  mf:name "cdata" ;
  rdfs:comment "Character data and a CDATA section beside it are one text child." ;
  mf:action [ bridge:input <cdata.xml> ] ;
  mf:result [ bridge:graph <cdata.nt> ] .

<#dropped> a bridge:LiftTest ;
  mf:name "dropped" ;
  rdfs:comment "The XML declaration, the document type declaration, comments and processing instructions are dropped, and text on either side of a dropped comment is one text child." ;
  mf:action [ bridge:input <dropped.xml> ] ;
  mf:result [ bridge:graph <dropped.nt> ] .

<#namespaces> a bridge:LiftTest ;
  mf:name "namespaces" ;
  rdfs:comment "A namespaced element or attribute is named by its namespace IRI and local name; an unnamespaced one under the Facade-X data namespace. The namespace declaration is not an attribute." ;
  mf:action [ bridge:input <namespaces.xml> ] ;
  mf:result [ bridge:graph <namespaces.nt> ] .
