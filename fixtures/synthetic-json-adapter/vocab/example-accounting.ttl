@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix ex:     <https://example.org/synthetic-adapter/v1#> .
@prefix pav:    <http://purl.org/pav/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

[] a bridge:PathEntry ;
  bridge:sourcePath "/kind" ;
  bridge:verdict bridge:ignored ;
  bridge:because "A kind says which envelope a document is in, not what the record says." .

[] a bridge:PathEntry ;
  bridge:sourcePath "/accession" ;
  bridge:verdict bridge:carried ;
  bridge:carriedAs [ bridge:asProperty ex:accession ; bridge:inRecordClass ex:Record ] .

[] a bridge:PathEntry ;
  bridge:sourcePath "/version" ;
  bridge:verdict bridge:carried ;
  bridge:carriedAs [ bridge:asProperty pav:version ; bridge:inRecordClass ex:Record ] .

[] a bridge:PathEntry ;
  bridge:sourcePath "/label" ;
  bridge:verdict bridge:carried ;
  bridge:carriedAs [ bridge:asProperty rdfs:label ; bridge:inRecordClass ex:Record ] .

[] a bridge:PathEntry ;
  bridge:sourcePath "/note" ;
  bridge:verdict bridge:noHome ;
  bridge:namesGap ex:no-term-for-a-free-text-note .

[] a bridge:PathEntry ;
  bridge:sourcePath "/status" ;
  bridge:verdict bridge:consumed ;
  bridge:lookupIn <example-statuses.ttl> ;
  bridge:lookupNamesGap ex:a-status-outside-the-set-the-vocabulary-fixes .

[] a bridge:PathEntry ;
  bridge:sourcePath "/contained" ;
  bridge:verdict bridge:consumed .

[] a bridge:PathEntry ;
  bridge:sourcePath "/contained/id" ;
  bridge:verdict bridge:carried ;
  bridge:carriedAs [ bridge:asProperty ex:accession ; bridge:inRecordClass ex:Record ] .

[] a bridge:PathEntry ;
  bridge:sourcePath "/contained/label" ;
  bridge:verdict bridge:carried ;
  bridge:carriedAs [ bridge:asProperty rdfs:label ; bridge:inRecordClass ex:Record ] .

[] a bridge:PathEntry ;
  bridge:sourcePath "/lastUpdated" ;
  bridge:verdict bridge:carried ;
  bridge:carriedAs [ bridge:asProperty pav:lastUpdateOn ; bridge:inRecordClass ex:Record ] .
