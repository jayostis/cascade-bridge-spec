PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ex:     <https://example.org/synthetic-adapter/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>

CONSTRUCT {
  ?held a ex:Record ;
    ex:accession ?id .
  ?heldVersion prov:specializationOf ?held ;
    rdfs:label ?label .
  [] bridge:arrivedAs ?heldVersion ;
    oa:hasSelector [ a oa:FragmentSelector ; dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc6901> ;
                     rdf:value ?heldSelector ] .
}
WHERE {
  ?exampleRecord a fx:root ;
    xyz:accession ?accession ;
    xyz:contained ?contained .
  OPTIONAL { ?exampleRecord xyz:version ?containerVersion }
  OPTIONAL { ?exampleRecord xyz:lastUpdated ?containerUpdated }
  ?contained ?slot ?item .
  ?item xyz:id ?id .
  bridge:thisDocument bridge:sha256 ?document .
  bridge:thisRecord bridge:selector ?selector .
  OPTIONAL { bridge:thisDocument cascade:serverBaseUrl ?server }
  {
    SELECT ?accession (COUNT(?holder) AS ?holders)
    WHERE { ?holder ex:holdsAccession ?accession }
    GROUP BY ?accession
  }
  BIND(IF(BOUND(?server) && ?holders = 1,
          CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromServerNamingRule",
                 "|", REPLACE(REPLACE(?server, "%", "%25"), "\\|", "%7C"),
                 "|", "ExampleRecord",
                 "|", REPLACE(REPLACE(?accession, "%", "%25"), "\\|", "%7C")),
          CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromDocumentNamingRule",
                 "|", REPLACE(REPLACE(?document, "%", "%25"), "\\|", "%7C"),
                 "|", REPLACE(REPLACE(?selector, "%", "%25"), "\\|", "%7C"))) AS ?named)
  BIND(SHA256(?named) AS ?hash)
  BIND(REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?hash, 17, 1),
         "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b") AS ?variant)
  BIND(CONCAT(SUBSTR(?hash, 1, 8), "-", SUBSTR(?hash, 9, 4), "-8", SUBSTR(?hash, 14, 3),
              "-", ?variant, SUBSTR(?hash, 18, 3), "-", SUBSTR(?hash, 21, 12)) AS ?uuid)
  BIND(SHA256(CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#ContainedRecordNamingRule",
                     "|", REPLACE(REPLACE(CONCAT("urn:uuid:", ?uuid), "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE(COALESCE(?containerVersion, ?containerUpdated, ""), "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE(?id, "%", "%25"), "\\|", "%7C"))) AS ?heldHash)
  BIND(REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?heldHash, 17, 1),
         "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b") AS ?heldVariant)
  BIND(CONCAT(SUBSTR(?heldHash, 1, 8), "-", SUBSTR(?heldHash, 9, 4), "-8", SUBSTR(?heldHash, 14, 3),
              "-", ?heldVariant, SUBSTR(?heldHash, 18, 3), "-", SUBSTR(?heldHash, 21, 12)) AS ?heldUuid)
  BIND(IRI(CONCAT("urn:uuid:", ?heldUuid)) AS ?held)
  BIND(IRI(CONCAT("https://example.org/synthetic-adapter/version/", ?heldUuid)) AS ?heldVersion)
  BIND(CONCAT(?selector, "/contained/", STR(xsd:integer(STRAFTER(STR(?slot), "#_")) - 1)) AS ?heldSelector)
  OPTIONAL { ?item xyz:label ?label }
}
