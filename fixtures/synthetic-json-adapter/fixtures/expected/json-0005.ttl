<ni:///sha-256;pHjHqyjOvuvssH5tfhw069EJAjeSecOmuCQBHpBfqfQ>
  a prov:Entity ;
  cascade:serverBaseUrl "https://records.example.org/api" ;
  pav:retrievedFrom <https://records.example.org/api/ExampleRecordSet> ;
  pav:retrievedOn "2026-08-30T22:14:00Z"^^xsd:dateTime ;
  prov:qualifiedAttribution
    [ prov:agent [ rdfs:label "Example Records Registry" ] ; prov:hadRole cascade:AuthorRole ] ,
    [ prov:agent [ rdfs:label "Example Fetcher" ] ; prov:hadRole cascade:TransmitterRole ] ;
  cascade:authenticatedPatient "Patient/example-patient" ;
  cascade:authenticatedAsProxy false ;
