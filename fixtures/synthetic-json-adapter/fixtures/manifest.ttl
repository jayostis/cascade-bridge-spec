@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "synthetic JSON adapter fixture cases" ;
  bridge:adapter <../> ;
  mf:entries (
    <#json-0001>
    <#json-0002>
    <#json-0003>
    <#json-0004>
    <#json-0005>
  ) .

<#json-0001> a bridge:IsomorphicConversionTest ;
  mf:name "json-0001" ;
  rdfs:comment "Each item of a set's records member is a record, selected by a JSON Pointer from the document's value. A note is reported by the findings query and by its entry, each refined to the note by a pointer relative to the record." ;
  mf:action [
    bridge:input <in/json-0001.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/json-0001.ttl> ;
    bridge:expectedFindings <findings/json-0001.ttl>
  ] .

<#json-0002> a bridge:IsomorphicConversionTest ;
  mf:name "json-0002" ;
  rdfs:comment "A record that is the document's value is selected by the empty pointer." ;
  mf:action [
    bridge:input <in/json-0002.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/json-0002.ttl> ;
    bridge:expectedFindings <findings/json-0002.ttl>
  ] .

<#json-0003> a bridge:IsomorphicConversionTest ;
  mf:name "json-0003" ;
  rdfs:comment "A document failing its envelope's JSON Schema, and a record failing the source schema through a $ref and directly: each failure is a finding whose body is the draft-06 section of the keyword failed, refined to the node it failed at, and no further where that node is the document's value. The record still goes through." ;
  mf:action [
    bridge:input <in/json-0003.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/json-0003.ttl> ;
    bridge:expectedFindings <findings/json-0003.ttl>
  ] .

<#json-0004> a bridge:IsomorphicConversionTest ;
  mf:name "json-0004" ;
  rdfs:comment "A record carrying members the accounting names nowhere, one of them an array of objects: an array's items stand at its path, so the census finding for it and for a member of its items is addressed at the first item and counts the items. A status the concept map lacks, written twice in an array, is one lookup finding at its first occurrence." ;
  mf:action [
    bridge:input <in/json-0004.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-set>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/json-0004.ttl> ;
    bridge:expectedFindings <findings/json-0004.ttl>
  ] .

<#json-0005> a bridge:IsomorphicConversionTest ;
  mf:name "json-0005" ;
  rdfs:comment "The input of json-0001 read in the record envelope, which admits it too: the whole document is then one record, the mapping finds no accession on it, the source schema reports the missing member, and the census reports every path below records. convert given --envelope naming each envelope in turn writes the findings of json-0001 and of this entry." ;
  mf:action [
    bridge:input <in/json-0001.json> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-record>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/json-0005.ttl> ;
    bridge:expectedFindings <findings/json-0005.ttl>
  ] .
