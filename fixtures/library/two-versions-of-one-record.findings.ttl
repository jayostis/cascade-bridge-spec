@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix ex:     <https://example.org/synthetic-adapter/v1#> .

[] a oa:Annotation ;
  oa:hasTarget [
    oa:hasSource <https://example.org/adapters/synthetic-adapter/fixtures/in/example-0001.xml> ;
    oa:hasSelector [
      a oa:XPathSelector ;
      rdf:value "/ExampleRecordSet/ExampleRecord[1]" ;
      oa:refinedBy [ a oa:XPathSelector ; rdf:value "Label[1]" ]
    ]
  ] ;
  oa:hasBody bridge:versionNotKept ;
  oa:motivatedBy oa:classifying ;
  sh:value "ni:///sha-256;4LOXL26w4NmH2053ZCbH362RHqkovIyRWHg8TWSjT2Q" ;
  sh:resultSeverity sh:Warning .

