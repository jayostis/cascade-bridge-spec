{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ns.cascadeprotocol.org/bridge/v1-draft/bench/manifest.schema.json",
  "title": "What a repository's benchmark harness measures on each of its inputs",
  "type": "object",
  "required": ["inputs"],
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input" }
    }
  },
  "$defs": {
    "segment": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "input": {
      "type": "object",
      "required": ["id", "path", "sha256", "bytes", "measures", "onPullRequests", "timeoutSeconds"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/segment" },
        "path": {
          "type": "string",
          "pattern": "^([^/\\\\]+/)*[^/\\\\]+$",
          "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "envelope": { "type": "string", "minLength": 1 },
        "measures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/segment", "not": { "enum": ["timeout", "refused"] } }
        },
        "onPullRequests": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
