PREFIX earl: <http://www.w3.org/ns/earl#>
PREFIX mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>

ASK {
  {
    FILTER NOT EXISTS { ?anyResult earl:outcome ?anyOutcome }
  }
  UNION
  {
    ?result earl:outcome ?outcome .
    FILTER (?outcome NOT IN (earl:passed, earl:cantTell, earl:untested))
  }
  UNION
  {
    ?manifest mf:entries/rdf:rest*/rdf:first ?entry .
    OPTIONAL { ?manifest bridge:adapter ?adapter }
    BIND (STRAFTER(STR(?entry), STR(?adapter)) AS ?withinAdapter)
    FILTER NOT EXISTS {
      ?assertion earl:test ?test ;
        earl:result/earl:outcome ?reported .
      FILTER (?test = ?entry
        || (?withinAdapter != "" && (STR(?test) = ?withinAdapter || STRENDS(STR(?test), CONCAT("/", ?withinAdapter)))))
    }
  }
  UNION
  {
    ?manifest mf:entries/rdf:rest*/rdf:first ?entry .
    ?entry a bridge:InputOnlyTest .
    OPTIONAL { ?manifest bridge:adapter ?adapter }
    BIND (STRAFTER(STR(?entry), STR(?adapter)) AS ?withinAdapter)
    ?assertion earl:test ?test ;
      earl:result/earl:outcome ?reported .
    FILTER (?reported != earl:cantTell)
    FILTER (?test = ?entry
      || (?withinAdapter != "" && (STR(?test) = ?withinAdapter || STRENDS(STR(?test), CONCAT("/", ?withinAdapter)))))
  }
}
