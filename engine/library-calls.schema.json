{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ns.cascadeprotocol.org/bridge/v1-draft/library-calls.schema.json",
  "title": "The calls file of an engine's library command",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "calls"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/call" }
        }
      }
    },
    "call": {
      "oneOf": [
        {
          "type": "object",
          "required": ["describe"],
          "additionalProperties": false,
          "properties": {
            "describe": {
              "type": "object",
              "required": ["adapter", "metadata", "format"],
              "additionalProperties": false,
              "properties": {
                "adapter": { "$ref": "#/$defs/iri" },
                "metadata": { "$ref": "#/$defs/path" },
                "format": { "$ref": "#/$defs/format" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["load"],
          "additionalProperties": false,
          "properties": { "load": { "$ref": "#/$defs/maps" } }
        },
        {
          "type": "object",
          "required": ["ask"],
          "additionalProperties": false,
          "properties": {
            "ask": {
              "type": "object",
              "required": ["document"],
              "additionalProperties": false,
              "properties": { "document": { "$ref": "#/$defs/document" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["convert"],
          "additionalProperties": false,
          "properties": {
            "convert": {
              "type": "object",
              "required": ["document", "format"],
              "additionalProperties": false,
              "properties": {
                "document": { "$ref": "#/$defs/document" },
                "format": { "$ref": "#/$defs/format" }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["test"],
          "additionalProperties": false,
          "properties": { "test": { "$ref": "#/$defs/maps" } }
        }
      ]
    },
    "maps": {
      "type": "object",
      "required": ["adapter"],
      "additionalProperties": false,
      "properties": {
        "adapter": { "$ref": "#/$defs/map" },
        "vocabulary": { "$ref": "#/$defs/map" }
      }
    },
    "map": {
      "type": "object",
      "required": ["iri", "files"],
      "additionalProperties": false,
      "properties": {
        "iri": { "$ref": "#/$defs/iri" },
        "files": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/path" }
        }
      }
    },
    "document": {
      "type": "object",
      "required": ["iri", "path"],
      "additionalProperties": false,
      "properties": {
        "iri": { "$ref": "#/$defs/iri" },
        "path": { "$ref": "#/$defs/path" },
        "envelope": { "$ref": "#/$defs/iri" },
        "facts": {
          "type": "object",
          "required": ["iri", "path"],
          "additionalProperties": false,
          "properties": {
            "iri": { "$ref": "#/$defs/iri" },
            "path": { "$ref": "#/$defs/path" }
          }
        }
      }
    },
    "format": { "enum": ["turtle", "ntriples"] },
    "iri": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:" },
    "path": { "type": "string", "minLength": 1 }
  }
}
