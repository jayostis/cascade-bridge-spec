@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix schema: <http://schema.org/> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt:     <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix oa:     <http://www.w3.org/ns/oa#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .
@prefix dct:    <http://purl.org/dc/terms/> .

<> a owl:Ontology ;
  sh:declare [ sh:prefix "rdf" ;    sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ;
  sh:declare [ sh:prefix "mf" ;     sh:namespace "http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#"^^xsd:anyURI ] ;
  sh:declare [ sh:prefix "oa" ;     sh:namespace "http://www.w3.org/ns/oa#"^^xsd:anyURI ] ;
  sh:declare [ sh:prefix "bridge" ; sh:namespace "https://ns.cascadeprotocol.org/bridge/v1-draft#"^^xsd:anyURI ] ;
  sh:declare [ sh:prefix "schema" ; sh:namespace "http://schema.org/"^^xsd:anyURI ] .

<#AdapterTestManifest> a sh:NodeShape ;
  sh:targetClass bridge:Adapter ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "The adapter's bridge:testManifest names a manifest whose bridge:adapter is this adapter." ;
    sh:select """
      SELECT $this ?value WHERE {
        $this bridge:testManifest ?value .
        FILTER NOT EXISTS { ?value bridge:adapter $this }
      }
    """
  ] .

<#Manifest> a sh:NodeShape ;
  sh:targetClass mf:Manifest ;
  sh:property [
    sh:path bridge:adapter ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class bridge:Adapter ;
    sh:message "The manifest carries at most one bridge:adapter, a bridge:Adapter by IRI: the root entity of the adapter's crate."
  ] ;
  sh:property [
    sh:path mf:entries ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:message "The manifest carries exactly one mf:entries list."
  ] ;
  sh:property [
    sh:path ( mf:entries [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
    sh:minCount 1 ;
    sh:node <#Entry> ;
    sh:message "mf:entries lists at least one test, and every member is a test of exactly one bridge: test type."
  ] ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "A manifest listing an adapter's test (bridge:IsomorphicConversionTest, bridge:InputOnlyTest, bridge:DatasetCompletionTest, bridge:IdentityRelationTest) carries exactly one bridge:adapter, a bridge:Adapter by IRI: the root entity of the adapter's crate." ;
    sh:select """
      SELECT DISTINCT $this (bridge:adapter AS ?path) WHERE {
        $this mf:entries/rdf:rest*/rdf:first/rdf:type ?type .
        FILTER (?type IN (bridge:IsomorphicConversionTest, bridge:InputOnlyTest, bridge:DatasetCompletionTest, bridge:IdentityRelationTest))
        FILTER NOT EXISTS { $this bridge:adapter ?adapter }
      }
    """
  ] ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "The manifest's bridge:adapter names an adapter whose bridge:testManifest is this manifest." ;
    sh:select """
      SELECT $this ?value WHERE {
        $this bridge:adapter ?value .
        FILTER NOT EXISTS { ?value bridge:testManifest $this }
      }
    """
  ] ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "Every bridge:envelope in an entry's action is one the manifest's adapter lists." ;
    sh:select """
      SELECT $this ?value WHERE {
        $this bridge:adapter ?adapter ;
              mf:entries/rdf:rest*/rdf:first/mf:action/bridge:conversion?/bridge:envelope ?value .
        FILTER NOT EXISTS { ?adapter bridge:envelope ?value }
      }
    """
  ] .

<#Entry> a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:xone (
    [ sh:class bridge:IsomorphicConversionTest ]
    [ sh:class bridge:InputOnlyTest ]
    [ sh:class bridge:DatasetCompletionTest ]
    [ sh:class bridge:LiftTest ]
    [ sh:class bridge:SkeletonTest ]
    [ sh:class bridge:NamingTest ]
    [ sh:class bridge:BaseUrlNormalisationTest ]
    [ sh:class bridge:VersioningTest ]
    [ sh:class bridge:IdentityRelationTest ]
    [ sh:class bridge:LibraryTest ]
  ) ;
  sh:message "A manifest entry is an IRI typed with exactly one of bridge:IsomorphicConversionTest, bridge:InputOnlyTest, bridge:DatasetCompletionTest, bridge:LiftTest, bridge:SkeletonTest, bridge:NamingTest, bridge:BaseUrlNormalisationTest, bridge:VersioningTest, bridge:IdentityRelationTest, bridge:LibraryTest." .

<#Test> a sh:NodeShape ;
  sh:targetClass bridge:IsomorphicConversionTest, bridge:InputOnlyTest, bridge:DatasetCompletionTest, bridge:LiftTest, bridge:SkeletonTest, bridge:NamingTest,
    bridge:BaseUrlNormalisationTest, bridge:VersioningTest, bridge:IdentityRelationTest, bridge:LibraryTest ;
  sh:nodeKind sh:IRI ;
  sh:property [
    sh:path mf:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Za-z0-9][A-Za-z0-9_.-]*$" ;
    sh:message "A test carries exactly one mf:name, the id that is also its fragment IRI."
  ] ;
  sh:property [
    sh:path mf:action ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:message "A test carries exactly one mf:action."
  ] .

<#IsomorphicConversionTest> a sh:NodeShape ;
  sh:targetClass bridge:IsomorphicConversionTest ;
  sh:property [
    sh:path mf:action ;
    sh:node <#CommittedAction>
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node <#ConversionResult> ;
    sh:message "An isomorphic conversion test carries exactly one mf:result naming the expected graph and findings."
  ] .

<#IdentityRelationTest> a sh:NodeShape ;
  sh:targetClass bridge:IdentityRelationTest ;
  sh:property [
    sh:path mf:action ;
    sh:node <#IdentityAction>
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node <#IdentityResult> ;
    sh:message "An identity relation test carries exactly one mf:result, saying whether its conversions name one record."
  ] .

<#IdentityAction> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:conversion ;
    sh:minCount 2 ;
    sh:maxCount 2 ;
    sh:node <#Conversion> ;
    sh:message "The action of an identity relation test carries exactly two bridge:conversion, each naming an input and its envelope, at most one file of facts and at most one bridge:selector."
  ] .

<#Conversion> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:input ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:MediaObject ;
    sh:message "A conversion names exactly one bridge:input, a crate File entity (schema:MediaObject)."
  ] ;
  sh:property [
    sh:path bridge:envelope ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class bridge:Envelope ;
    sh:message "A conversion names exactly one bridge:envelope, a bridge:Envelope by IRI."
  ] ;
  sh:property [
    sh:path bridge:facts ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:MediaObject ;
    sh:message "A conversion names at most one bridge:facts, a crate File entity (schema:MediaObject)."
  ] ;
  sh:property [
    sh:path bridge:selector ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "A conversion carries at most one bridge:selector, a plain string: where the record it names stood in its input."
  ] .

<#IdentityResult> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:sameRecord ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
    sh:message "The result of an identity relation test carries exactly one bridge:sameRecord, an xsd:boolean."
  ] .

<#InputOnlyTest> a sh:NodeShape ;
  sh:targetClass bridge:InputOnlyTest ;
  sh:property [
    sh:path mf:action ;
    sh:node <#CommittedAction>
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:maxCount 0 ;
    sh:message "An input-only test has no mf:result: nothing is judged."
  ] .

<#DatasetCompletionTest> a sh:NodeShape ;
  sh:targetClass bridge:DatasetCompletionTest ;
  sh:property [
    sh:path mf:action ;
    sh:node <#DatasetAction>
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:maxCount 1 ;
    sh:node <#DatasetResult> ;
    sh:message "A dataset completion test carries at most one mf:result, holding bridge:recordsProcessedCount and bridge:outputDigest once a run has recorded them."
  ] .

<#BridgeTest> a sh:NodeShape ;
  sh:targetClass bridge:LiftTest, bridge:SkeletonTest, bridge:NamingTest, bridge:BaseUrlNormalisationTest, bridge:VersioningTest ;
  sh:property [
    sh:path mf:result ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A test of a Bridge carries exactly one mf:result."
  ] ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "A test of a Bridge is listed only in a manifest that names no bridge:adapter." ;
    sh:select """
      SELECT $this ?value WHERE {
        ?manifest mf:entries/rdf:rest*/rdf:first $this ;
          bridge:adapter ?value .
      }
    """
  ] .

<#LiftTest> a sh:NodeShape ;
  sh:targetClass bridge:LiftTest ;
  sh:property [
    sh:path mf:action ;
    sh:node <#LiftAction>
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:node <#LiftResult>
  ] .

<#SkeletonTest> a sh:NodeShape ;
  sh:targetClass bridge:SkeletonTest ;
  sh:property [
    sh:path mf:action ;
    sh:node <#SkeletonAction>
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:node <#LiftResult>
  ] .

<#NamingTest> a sh:NodeShape ;
  sh:targetClass bridge:NamingTest ;
  sh:property [
    sh:path mf:action ;
    sh:node <#NamingAction>
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:node <#NamingResult>
  ] .

<#NamingAction> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path qt:query ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The action of a naming test names exactly one qt:query, the query computing a name from ?input, by IRI."
  ] ;
  sh:property [
    sh:path bridge:nameInputs ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "The action of a naming test carries exactly one bridge:nameInputs list."
  ] ;
  sh:property [
    sh:path ( bridge:nameInputs [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "bridge:nameInputs lists at least one input, each a plain string."
  ] .

<#NamingResult> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:expectedName ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" ;
    sh:message "The result of a naming test names exactly one bridge:expectedName, urn:uuid: and a lower-case UUID of version 8 and variant 10."
  ] .

<#BaseUrlNormalisationTest> a sh:NodeShape ;
  sh:targetClass bridge:BaseUrlNormalisationTest ;
  sh:property [
    sh:path mf:action ;
    sh:node <#ServerBaseUrl>
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:node <#ServerBaseUrl>
  ] .

<#ServerBaseUrl> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:serverBaseUrl ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "The action and the result of a base URL normalisation test each carry exactly one bridge:serverBaseUrl, a plain string."
  ] .

<#VersioningTest> a sh:NodeShape ;
  sh:targetClass bridge:VersioningTest ;
  sh:property [
    sh:path mf:action ;
    sh:node <#VersioningAction>
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:node <#VersioningResult>
  ] .

<#VersioningAction> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:input ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The action of a versioning test names exactly one bridge:input, the N-Triples a mapping constructed, by IRI."
  ] .

<#VersioningResult> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:expectedGraph ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The result of a versioning test names exactly one bridge:expectedGraph, the graph with every version named, by IRI."
  ] ;
  sh:property [
    sh:path bridge:expectedVersion ;
    sh:minCount 1 ;
    sh:node <#ExpectedVersion> ;
    sh:message "The result of a versioning test carries a bridge:expectedVersion for each version the input holds."
  ] .

<#ExpectedVersion> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:expectedName ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^ni:///sha-256;[A-Za-z0-9_-]{43}$" ;
    sh:message "An expected version names exactly one bridge:expectedName, ni:///sha-256; and 43 unpadded base64url characters."
  ] ;
  sh:property [
    sh:path bridge:canonicalContent ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "An expected version names exactly one bridge:canonicalContent, the N-Quads its name is the hash of, by IRI."
  ] .

<#CommittedAction> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:input ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:MediaObject ;
    sh:message "The action of a committed-input test names exactly one bridge:input, and it is a crate File entity (schema:MediaObject), not a bare IRI naming nothing."
  ] ;
  sh:property [
    sh:path bridge:envelope ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class bridge:Envelope ;
    sh:message "The action names exactly one bridge:envelope, a bridge:Envelope by IRI."
  ] ;
  sh:property [
    sh:path bridge:facts ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:MediaObject ;
    sh:message "The action names at most one bridge:facts, the Turtle file of facts supplied with its input, and it is a crate File entity (schema:MediaObject), not a bare IRI naming nothing."
  ] .

<#DatasetAction> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:dataset ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node <#RunnableDataset> ;
    sh:message "The action of a dataset completion test names exactly one bridge:dataset, by the crate entity's IRI: a Dataset with a contentUrl, one a Bridge can fetch."
  ] ;
  sh:property [
    sh:path bridge:envelope ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class bridge:Envelope ;
    sh:message "The action names exactly one bridge:envelope, a bridge:Envelope by IRI."
  ] .

<#RunnableDataset> a sh:NodeShape ;
  sh:class schema:Dataset ;
  sh:property [
    sh:path schema:contentUrl ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A dataset a test runs carries exactly one schema:contentUrl."
  ] .

<#ConversionResult> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:expectedGraph ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:MediaObject ;
    sh:message "The result names exactly one bridge:expectedGraph, the expected Turtle, and it is a crate File entity (schema:MediaObject), not a bare IRI naming nothing."
  ] ;
  sh:property [
    sh:path bridge:expectedFindings ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class schema:MediaObject ;
    sh:message "The result names exactly one bridge:expectedFindings, the Turtle graph of the findings the entry must produce, and it is a crate File entity (schema:MediaObject), not a bare IRI naming nothing."
  ] .

<#SourceFinding> a sh:NodeShape ;
  sh:targetClass oa:Annotation ;
  sh:nodeKind sh:BlankNode ;
  sh:message "A finding is a blank node written for that one finding: a name is one node for every finding, and which target, body and severity standing on it belong to which finding is then unrecoverable." ;
  sh:property [
    sh:path oa:hasTarget ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node <#FindingTarget> ;
    sh:message "A finding about the source document carries exactly one oa:hasTarget, naming the document the record was read from and selecting the node the finding is about."
  ] ;
  sh:property [
    sh:path oa:hasBody ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A finding carries exactly one oa:hasBody, an IRI: the code the finding is an instance of, never a sentence."
  ] ;
  sh:property [
    sh:path oa:motivatedBy ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue oa:classifying ;
    sh:message "A finding carries exactly one oa:motivatedBy, oa:classifying."
  ] ;
  sh:property [
    sh:path sh:value ;
    sh:maxCount 1 ;
    sh:message "A finding carries at most one sh:value, what in the source it is about."
  ] ;
  sh:property [
    sh:path bridge:occurrences ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 2 ;
    sh:message "A finding carries at most one bridge:occurrences, how many nodes of the record stand at the path it is about, an xsd:integer of 2 or more: a count of one is written by omitting it."
  ] ;
  sh:property [
    sh:path sh:resultSeverity ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( sh:Info sh:Warning sh:Violation ) ;
    sh:message "A finding carries exactly one sh:resultSeverity, one of sh:Info, sh:Warning, sh:Violation."
  ] .

<#OutputValidationFinding> a sh:NodeShape ;
  sh:targetSubjectsOf sh:resultPath, sh:focusNode ;
  sh:property [
    sh:path sh:resultPath ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A finding about the produced graph carries at most one sh:resultPath, by IRI: the predicate the SHACL result that made it stands on."
  ] ;
  sh:property [
    sh:path sh:focusNode ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A finding about the produced graph carries at most one sh:focusNode, and carries it only where the node the SHACL result is about is an IRI: a blank node of the produced graph names nothing a reader can follow."
  ] ;
  sh:property [
    sh:path ( oa:hasTarget oa:hasSelector oa:refinedBy ) ;
    sh:maxCount 0 ;
    sh:message "A finding about the produced graph selects the record its result came from, refined no further: which node broke is sh:focusNode and sh:resultPath, not a place in the source."
  ] .

<#UndeclaredPredicateFinding> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE { ?this oa:hasBody bridge:predicateNotDeclared }
    """
  ] ;
  sh:property [
    sh:path sh:resultPath ;
    sh:minCount 1 ;
    sh:message "A finding whose body is bridge:predicateNotDeclared carries the predicate no ontology declares as its sh:resultPath."
  ] ;
  sh:property [
    sh:path sh:resultSeverity ;
    sh:hasValue sh:Violation ;
    sh:message "A finding whose body is bridge:predicateNotDeclared carries sh:resultSeverity sh:Violation: a predicate outside every ontology the adapter is pinned to leaves the graph unreadable."
  ] .

<#FindingTarget> a sh:NodeShape ;
  sh:property [
    sh:path oa:hasSource ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A finding's target names exactly one oa:hasSource by IRI, the document the record was read from."
  ] ;
  sh:property [
    sh:path oa:hasSelector ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node <#RecordSelector> ;
    sh:message "A finding's target carries exactly one oa:hasSelector, the record's selector."
  ] ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "A finding's target carries a selector of its own, shared with no other finding: selectors on one node are alternative ways of selecting the same thing." ;
    sh:select """
      SELECT $this ?value WHERE {
        $this oa:hasSelector ?value .
        ?other oa:hasSelector ?value .
        FILTER (?other != $this)
      }
    """
  ] ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "A finding carries a target of its own, shared with no other finding: two findings on one target stand on that target's one selector, and which node each finding is about is then unrecoverable." ;
    sh:select """
      SELECT $this ?value WHERE {
        ?value oa:hasTarget $this .
        ?other oa:hasTarget $this .
        FILTER (?other != ?value)
      }
    """
  ] .

<#RecordSelector> a sh:NodeShape ;
  sh:or (
    [ sh:class oa:XPathSelector ]
    [ sh:class oa:FragmentSelector ; sh:property [ sh:path dct:conformsTo ; sh:hasValue <https://www.rfc-editor.org/rfc/rfc6901> ] ]
  ) ;
  sh:message "A record's selector is an oa:XPathSelector, or an oa:FragmentSelector whose dcterms:conformsTo is JSON Pointer, <https://www.rfc-editor.org/rfc/rfc6901>." ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "A selector refining a record's selector is of its kind: an oa:XPathSelector refines an oa:XPathSelector, and an oa:FragmentSelector an oa:FragmentSelector." ;
    sh:select """
      SELECT $this ?value WHERE {
        $this oa:refinedBy ?value .
        FILTER NOT EXISTS {
          $this a ?kind .
          ?value a ?kind .
          FILTER (?kind IN (oa:XPathSelector, oa:FragmentSelector))
        }
      }
    """
  ] ;
  sh:property [
    sh:path rdf:value ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "A selector carries exactly one rdf:value, its XPath or its JSON Pointer, a string."
  ] ;
  sh:property [
    sh:path oa:refinedBy ;
    sh:maxCount 1 ;
    sh:node <#RefinedSelector> ;
    sh:message "A record's selector is refined by at most one selector, the one the finding names inside the record."
  ] .

<#RefinedSelector> a sh:NodeShape ;
  sh:or (
    [ sh:class oa:XPathSelector ]
    [ sh:class oa:FragmentSelector ; sh:property [ sh:path dct:conformsTo ; sh:hasValue <https://www.rfc-editor.org/rfc/rfc6901> ] ]
  ) ;
  sh:message "A selector refining a record's selector is an oa:XPathSelector, or an oa:FragmentSelector whose dcterms:conformsTo is JSON Pointer, <https://www.rfc-editor.org/rfc/rfc6901>." ;
  sh:property [
    sh:path rdf:value ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "A selector carries exactly one rdf:value, its XPath or its JSON Pointer, a string."
  ] ;
  sh:property [
    sh:path oa:refinedBy ;
    sh:maxCount 0 ;
    sh:message "A selector refining a record's selector is refined no further."
  ] .

<#SubjectOfASourcePath> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE { ?this bridge:sourcePath ?path }
    """
  ] ;
  sh:class bridge:PathEntry ;
  sh:message "A subject of a bridge:sourcePath is a bridge:PathEntry." .

<#PathEntry> a sh:NodeShape ;
  sh:targetClass bridge:PathEntry ;
  sh:property [
    sh:path bridge:sourcePath ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "An entry carries exactly one bridge:sourcePath, the path it accounts for, a string."
  ] ;
  sh:property [
    sh:path bridge:verdict ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( bridge:carried bridge:carriedInPart bridge:redundantWith bridge:consumed bridge:noHome bridge:ignored ) ;
    sh:message "An entry carries exactly one bridge:verdict, one of bridge:carried, bridge:carriedInPart, bridge:redundantWith, bridge:consumed, bridge:noHome, bridge:ignored."
  ] ;
  sh:property [
    sh:path bridge:lookupIn ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "An entry carries at most one bridge:lookupIn, the concept map the values at its path are looked up in: a bridge:table of the crate, by IRI."
  ] ;
  sh:property [
    sh:path bridge:lookupNamesGap ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "An entry carries at most one bridge:lookupNamesGap, the gap a value outside its bridge:lookupIn opens: a gap of the adapter's bridge:gapScheme, by IRI."
  ] .

<#EntryLookingItsValuesUp> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE {
        ?this a bridge:PathEntry .
        { ?this bridge:lookupIn ?map } UNION { ?this bridge:lookupNamesGap ?gap }
      }
    """
  ] ;
  sh:property [
    sh:path bridge:lookupIn ;
    sh:minCount 1 ;
    sh:message "An entry naming a bridge:lookupNamesGap names the bridge:lookupIn that gap is a value outside: a lookup is a concept map and the gap a value the map lacks opens, and neither half stands without the other."
  ] ;
  sh:property [
    sh:path bridge:lookupNamesGap ;
    sh:minCount 1 ;
    sh:message "An entry naming a bridge:lookupIn names the bridge:lookupNamesGap a value outside that map opens: a lookup is a concept map and the gap a value the map lacks opens, and neither half stands without the other."
  ] .

<#CarriedEntry> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE { ?this a bridge:PathEntry ; bridge:verdict bridge:carried }
    """
  ] ;
  sh:property [
    sh:path bridge:namesGap ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:carried names no bridge:namesGap."
  ] ;
  sh:property [
    sh:path bridge:sameFactAs ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:carried names no bridge:sameFactAs."
  ] ;
  sh:property [
    sh:path bridge:because ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:carried gives no bridge:because."
  ] .

<#CarriedInPartEntry> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE { ?this a bridge:PathEntry ; bridge:verdict bridge:carriedInPart }
    """
  ] ;
  sh:property [
    sh:path bridge:namesGap ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An entry whose verdict is bridge:carriedInPart names exactly one bridge:namesGap, the gap the loss opens."
  ] ;
  sh:property [
    sh:path bridge:sameFactAs ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:carriedInPart names no bridge:sameFactAs."
  ] ;
  sh:property [
    sh:path bridge:because ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:carriedInPart gives no bridge:because."
  ] .

<#RedundantWithEntry> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE { ?this a bridge:PathEntry ; bridge:verdict bridge:redundantWith }
    """
  ] ;
  sh:property [
    sh:path bridge:sameFactAs ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An entry whose verdict is bridge:redundantWith names exactly one bridge:sameFactAs, the bridge:sourcePath that carries the fact instead."
  ] ;
  sh:property [
    sh:path bridge:namesGap ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:redundantWith names no bridge:namesGap."
  ] ;
  sh:property [
    sh:path bridge:because ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:redundantWith gives no bridge:because."
  ] .

<#ConsumedEntry> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE { ?this a bridge:PathEntry ; bridge:verdict bridge:consumed }
    """
  ] ;
  sh:property [
    sh:path bridge:namesGap ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:consumed names no bridge:namesGap."
  ] ;
  sh:property [
    sh:path bridge:sameFactAs ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:consumed names no bridge:sameFactAs."
  ] ;
  sh:property [
    sh:path bridge:because ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:consumed gives no bridge:because."
  ] .

<#NoHomeEntry> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE { ?this a bridge:PathEntry ; bridge:verdict bridge:noHome }
    """
  ] ;
  sh:property [
    sh:path bridge:namesGap ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An entry whose verdict is bridge:noHome names exactly one bridge:namesGap, the gap the missing predicate opens."
  ] ;
  sh:property [
    sh:path bridge:sameFactAs ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:noHome names no bridge:sameFactAs."
  ] ;
  sh:property [
    sh:path bridge:because ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:noHome gives no bridge:because."
  ] .

<#IgnoredEntry> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE { ?this a bridge:PathEntry ; bridge:verdict bridge:ignored }
    """
  ] ;
  sh:property [
    sh:path bridge:because ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "An entry whose verdict is bridge:ignored gives exactly one bridge:because, why the path is deliberately not carried."
  ] ;
  sh:property [
    sh:path bridge:namesGap ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:ignored names no bridge:namesGap."
  ] ;
  sh:property [
    sh:path bridge:sameFactAs ;
    sh:maxCount 0 ;
    sh:message "An entry whose verdict is bridge:ignored names no bridge:sameFactAs."
  ] .

<#DatasetResult> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:recordsProcessedCount ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:message "bridge:recordsProcessedCount is a non-negative xsd:integer, at most once."
  ] ;
  sh:property [
    sh:path bridge:outputDigest ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^sha256:[0-9a-f]{64}$" ;
    sh:message "bridge:outputDigest is the string sha256:<64 lowercase hex>, at most once."
  ] .

<#LiftAction> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:sourceMediaType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^(application/(xml|json)|text/xml|[a-z]+/[a-z0-9.!#$&^_-]+[+](xml|json))$" ;
    sh:message "The action of a test of a Bridge names exactly one bridge:sourceMediaType, which selects the lift: application/xml, text/xml or a +xml type for the XML lift, application/json or a +json type for the JSON lift."
  ] ;
  sh:property [
    sh:path bridge:input ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The action of a lift test names exactly one bridge:input, the document lifted, by IRI."
  ] .

<#SkeletonAction> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:sourceMediaType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "^(application/(xml|json)|text/xml|[a-z]+/[a-z0-9.!#$&^_-]+[+](xml|json))$" ;
    sh:message "The action of a test of a Bridge names exactly one bridge:sourceMediaType, which selects the lift: application/xml, text/xml or a +xml type for the XML lift, application/json or a +json type for the JSON lift."
  ] ;
  sh:property [
    sh:path bridge:input ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The action of a skeleton test names exactly one bridge:input, the document the skeleton is built from, by IRI."
  ] ;
  sh:property [
    sh:path bridge:elementNameOfEachRecord ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "The action of a skeleton test names at most one bridge:elementNameOfEachRecord, the local name of the XML element emptied, a string."
  ] ;
  sh:property [
    sh:path bridge:jsonPathOfEachRecord ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "The action of a skeleton test names at most one bridge:jsonPathOfEachRecord, the JSONPath selecting the JSON records emptied, a string."
  ] ;
  sh:xone (
    [ sh:path bridge:elementNameOfEachRecord ; sh:minCount 1 ]
    [ sh:path bridge:jsonPathOfEachRecord ; sh:minCount 1 ]
  ) ;
  sh:message "The action of a skeleton test names exactly one of bridge:elementNameOfEachRecord, the local name of the XML element emptied, and bridge:jsonPathOfEachRecord, the JSONPath selecting the JSON records emptied." .

<#LiftResult> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:expectedGraph ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The result of a lift test names exactly one bridge:expectedGraph, the graph the lift must be isomorphic to, by IRI."
  ] .

<#LibraryTest> a sh:NodeShape ;
  sh:targetClass bridge:LibraryTest ;
  sh:property [
    sh:path ( mf:action [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
    sh:minCount 1 ;
    sh:node <#LibraryCall> ;
    sh:message "The action of a library test is a list of at least one call, each a blank node typed with exactly one of bridge:DescribeCall, bridge:LoadCall, bridge:AskCall, bridge:ConvertCall, bridge:TestCall."
  ] ;
  sh:property [
    sh:path mf:result ;
    sh:maxCount 0 ;
    sh:message "A library test has no mf:result: each call carries what it must return."
  ] ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "A bridge:AskCall or bridge:ConvertCall comes after a bridge:LoadCall in its library test's list of calls." ;
    sh:select """
      SELECT $this ?value WHERE {
        $this mf:action ?calls .
        ?calls rdf:rest* ?at .
        ?at rdf:first ?value .
        ?value a ?type .
        FILTER (?type IN (bridge:AskCall, bridge:ConvertCall))
        FILTER NOT EXISTS {
          ?calls rdf:rest* ?earlier .
          ?earlier rdf:rest+ ?at ; rdf:first/a bridge:LoadCall .
        }
      }
    """
  ] .

<#LibraryCall> a sh:NodeShape ;
  sh:nodeKind sh:BlankNode ;
  sh:xone (
    [ sh:class bridge:DescribeCall ]
    [ sh:class bridge:LoadCall ]
    [ sh:class bridge:AskCall ]
    [ sh:class bridge:ConvertCall ]
    [ sh:class bridge:TestCall ]
  ) ;
  sh:message "A library call is a blank node typed with exactly one of bridge:DescribeCall, bridge:LoadCall, bridge:AskCall, bridge:ConvertCall, bridge:TestCall." .

<#DescribeCall> a sh:NodeShape ;
  sh:targetClass bridge:DescribeCall ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:adapterFiles ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node <#FileMap> ;
    sh:message "A describe call names exactly one bridge:adapterFiles, the map its ro-crate-metadata.json is read from."
  ] ;
  sh:property <#GraphFormat> ;
  sh:property [
    sh:path bridge:expectedGraph ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A describe call names at most one bridge:expectedGraph, the description it must return, by IRI."
  ] ;
  sh:property <#ExpectedFailure> ;
  sh:xone (
    [ sh:path bridge:expectedGraph ; sh:minCount 1 ]
    [ sh:path bridge:failure ; sh:minCount 1 ]
  ) ;
  sh:message "A describe call names exactly one of bridge:expectedGraph and bridge:failure." .

<#LoadCall> a sh:NodeShape ;
  sh:targetClass bridge:LoadCall, bridge:TestCall ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:adapterFiles ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node <#FileMap> ;
    sh:message "A load or test call names exactly one bridge:adapterFiles, the adapter's map of files."
  ] ;
  sh:property [
    sh:path bridge:vocabularyFiles ;
    sh:maxCount 1 ;
    sh:node <#FileMap> ;
    sh:message "A load or test call names at most one bridge:vocabularyFiles, the vocabulary's map of files."
  ] ;
  sh:property <#ExpectedFailure> ;
  sh:property <#MissingFile> .

<#AskCall> a sh:NodeShape ;
  sh:targetClass bridge:AskCall ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property <#Document> ;
  sh:property <#SuppliedFacts> ;
  sh:property <#NamedEnvelope> ;
  sh:property [
    sh:path bridge:expectedAnswer ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
    sh:message "An ask call carries at most one bridge:expectedAnswer, an xsd:boolean."
  ] ;
  sh:property <#ExpectedFailure> ;
  sh:xone (
    [ sh:path bridge:expectedAnswer ; sh:minCount 1 ]
    [ sh:path bridge:failure ; sh:minCount 1 ]
  ) ;
  sh:message "An ask call carries exactly one of bridge:expectedAnswer and bridge:failure." .

<#ConvertCall> a sh:NodeShape ;
  sh:targetClass bridge:ConvertCall ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property <#Document> ;
  sh:property <#SuppliedFacts> ;
  sh:property <#NamedEnvelope> ;
  sh:property <#GraphFormat> ;
  sh:property [
    sh:path bridge:expectedGraph ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A convert call names at most one bridge:expectedGraph, the graph it must return, by IRI."
  ] ;
  sh:property [
    sh:path bridge:expectedFindings ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A convert call names at most one bridge:expectedFindings, the findings it must return, by IRI: naming none, it must return none."
  ] ;
  sh:property <#ExpectedFailure> ;
  sh:xone (
    [ sh:path bridge:expectedGraph ; sh:minCount 1 ]
    [ sh:path bridge:failure ; sh:minCount 1 ]
  ) ;
  sh:message "A convert call names exactly one of bridge:expectedGraph and bridge:failure." ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "A convert call naming a bridge:failure names no bridge:expectedFindings." ;
    sh:select """
      SELECT $this ?value WHERE { $this bridge:failure ?kind ; bridge:expectedFindings ?value . }
    """
  ] .

<#GraphFormat> a sh:PropertyShape ;
  sh:path bridge:graphFormat ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:in ( "turtle" "ntriples" ) ;
  sh:message "A describe or convert call carries exactly one bridge:graphFormat, the format the graph is returned in: turtle or ntriples." .

<#Document> a sh:PropertyShape ;
  sh:path bridge:document ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:node <#NamedFile> ;
  sh:message "An ask or convert call names exactly one bridge:document." .

<#SuppliedFacts> a sh:PropertyShape ;
  sh:path bridge:suppliedFacts ;
  sh:maxCount 1 ;
  sh:node <#NamedFile> ;
  sh:message "An ask or convert call names at most one bridge:suppliedFacts." .

<#NamedEnvelope> a sh:PropertyShape ;
  sh:path bridge:envelope ;
  sh:maxCount 1 ;
  sh:nodeKind sh:IRI ;
  sh:message "An ask or convert call names at most one bridge:envelope, the IRI of the envelope its document is read in." .

<#ExpectedFailure> a sh:PropertyShape ;
  sh:path bridge:failure ;
  sh:maxCount 1 ;
  sh:in ( bridge:documentFailure bridge:factsFailure bridge:adapterFailure bridge:vocabularyFailure bridge:fileMissingFailure bridge:bridgeFailure ) ;
  sh:message "A call names at most one bridge:failure, the kind it must fail with: one of bridge:documentFailure, bridge:factsFailure, bridge:adapterFailure, bridge:vocabularyFailure, bridge:fileMissingFailure, bridge:bridgeFailure." .

<#MissingFile> a sh:PropertyShape ;
  sh:path bridge:missingFile ;
  sh:maxCount 1 ;
  sh:nodeKind sh:IRI ;
  sh:message "A load or test call names at most one bridge:missingFile, by IRI: its map's bridge:iri followed by its path." .

<#FailingForAMissingFile> a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes <> ;
    sh:select """
      SELECT ?this WHERE {
        { ?this bridge:failure bridge:fileMissingFailure } UNION { ?this bridge:missingFile ?file }
      }
    """
  ] ;
  sh:property [
    sh:path bridge:failure ;
    sh:hasValue bridge:fileMissingFailure ;
    sh:message "A call naming a bridge:missingFile fails with bridge:fileMissingFailure."
  ] ;
  sh:property [
    sh:path bridge:missingFile ;
    sh:minCount 1 ;
    sh:message "A call failing with bridge:fileMissingFailure names the bridge:missingFile it must name."
  ] .

<#FileMap> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:message "A map of files carries only a bridge:iri, a bridge:directory, its bridge:withholds and its bridge:substitute." ;
  sh:property [
    sh:path bridge:iri ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "/$" ;
    sh:message "A map of files carries exactly one bridge:iri, ending in /, that each key resolves against."
  ] ;
  sh:property [
    sh:path bridge:directory ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "/$" ;
    sh:message "A map of files carries exactly one bridge:directory, ending in /, whose files it holds."
  ] ;
  sh:property [
    sh:path bridge:withholds ;
    sh:datatype xsd:string ;
    sh:message "Each bridge:withholds of a map is a key, a plain string."
  ] ;
  sh:property [
    sh:path bridge:substitute ;
    sh:node <#Substitute> ;
    sh:message "Each bridge:substitute of a map names a bridge:key and the bridge:file held under it."
  ] .

<#Substitute> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:key ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "A substitute carries exactly one bridge:key, a plain string."
  ] ;
  sh:property [
    sh:path bridge:file ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A substitute names exactly one bridge:file, by IRI."
  ] .

<#NamedFile> a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [
    sh:path bridge:iri ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A document or its facts carries exactly one bridge:iri, the IRI the caller gives it."
  ] ;
  sh:property [
    sh:path bridge:file ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A document or its facts names exactly one bridge:file, its bytes, by IRI."
  ] .

<#Compatibility> a sh:NodeShape ;
  sh:targetSubjectsOf bridge:host, bridge:mustPassWith ;
  sh:property [
    sh:path bridge:mustPassWith ;
    sh:nodeKind sh:IRI ;
    sh:message "Each mustPassWith entry is a repository URL; which version of it the pairing uses is picked when the check runs."
  ] ;
  sh:property [
    sh:path bridge:host ;
    sh:node <#Host> ;
    sh:message "Each host of an engine is a JSON object carrying a name, a setup and a command."
  ] ;
  sh:sparql [
    sh:prefixes <> ;
    sh:message "Each host of an engine has a name no other host of it has: {?value} names more than one." ;
    sh:select """
      SELECT $this ?value WHERE {
        $this bridge:host ?one, ?other .
        ?one schema:name ?value .
        ?other schema:name ?value .
        FILTER (?one != ?other)
      }
    """
  ] .

<#SetupAndCommandInAHost> a sh:NodeShape ;
  sh:targetSubjectsOf bridge:setup, bridge:command ;
  sh:property [
    sh:path [ sh:inversePath bridge:host ] ;
    sh:minCount 1 ;
    sh:message "A setup and a command belong to a host, in an engine's list of hosts, never at the top of a compatibility.json."
  ] .

<#Host> a sh:NodeShape ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "A host carries exactly one name, a string."
  ] ;
  sh:property [
    sh:path bridge:setup ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A host carries exactly one setup."
  ] ;
  sh:property [
    sh:path ( bridge:setup [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "A host's setup is an argument vector, a JSON array of one or more strings."
  ] ;
  sh:property [
    sh:path bridge:command ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "A host carries exactly one command."
  ] ;
  sh:property [
    sh:path ( bridge:command [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "A host's command is an argument vector, a JSON array of one or more strings."
  ] .
